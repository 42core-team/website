# Copy this file to .env.tilt and fill in the values.
# .env.tilt is gitignored and never committed.
# All other dev credentials are hardcoded in tilt/local-values/*.yaml.

# GitHub OAuth app (create one at https://github.com/settings/developers)
# Callback URL: http://localhost:4000/auth/github/callback
CLIENT_GITHUB_ID=
CLIENT_GITHUB_SECRET=

# 42 OAuth app
# Callback URL: http://localhost:4000/auth/42/callback
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=

# CORE GitHub App (required for team repositories; without it events cannot create them)
# Run `make github-app` to create your own dev App and fill these in, or see docs/github-app.md
# Setup URL: http://localhost:3000/github/setup
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Single line: base64 < your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
