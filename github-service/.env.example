RABBITMQ_URL=amqp://guest:guest@localhost:5672 # rabbitmq connectin details
RABBITMQ_QUEUE_PREFIX=
API_SECRET_ENCRYPTION_KEY=secret-encryption-key # Same key as the api uses to encrypt/decrypt the github api keys with
# NODE_ENV=development (set by `pnpm start:dev`) makes operations on seeded sim-<teamId> repositories succeed without calling GitHub. Never set it in production.
